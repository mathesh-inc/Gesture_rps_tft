#include <Arduino.h>
#include <U8g2lib.h>
#include <Wire.h>

// ==================================================
// OLED
// ==================================================

U8G2_SH1106_128X64_NONAME_F_HW_I2C oled(
    U8G2_R0,
    U8X8_PIN_NONE
);

// ==================================================
// BUTTONS
// ==================================================

#define BTN_LEFT   3
#define BTN_RIGHT  33
#define BTN_ACTION 25

// ==================================================
// GAME SETTINGS
// ==================================================

#define SCREEN_WIDTH  128
#define SCREEN_HEIGHT 64

#define CELL_SIZE 4

#define GRID_WIDTH  (SCREEN_WIDTH / CELL_SIZE)
#define GRID_HEIGHT (SCREEN_HEIGHT / CELL_SIZE)

#define MAX_SNAKE 100

// ==================================================
// SNAKE
// ==================================================

int snakeX[MAX_SNAKE];
int snakeY[MAX_SNAKE];

int snakeLength;

int directionX;
int directionY;

int foodX;
int foodY;

int score;

bool gameOver = false;

// ==================================================
// TIMING
// ==================================================

unsigned long lastMove = 0;

int gameSpeed = 150;

// ==================================================
// BUTTON STATE
// ==================================================

bool lastLeft = HIGH;
bool lastRight = HIGH;
bool lastAction = HIGH;

// ==================================================
// FUNCTION DECLARATIONS
// IMPORTANT FOR PLATFORMIO / C++
// ==================================================

void showStartScreen();
void showGameOver();
void startGame();
void readButtons();
void moveSnake();
void checkCollision();
void spawnFood();
void checkFood();
void drawGame();

// ==================================================
// SETUP
// ==================================================

void setup()
{
    Serial.begin(115200);

    // OLED
    oled.begin();
    oled.clearBuffer();

    // Buttons
    pinMode(BTN_LEFT, INPUT_PULLUP);
    pinMode(BTN_RIGHT, INPUT_PULLUP);
    pinMode(BTN_ACTION, INPUT_PULLUP);

    // Random seed
    randomSeed(analogRead(34));

    // Start screen
    showStartScreen();
}

// ==================================================
// LOOP
// ==================================================

void loop()
{
    // If game is over
    if (gameOver)
    {
        showGameOver();

        // Wait for ACTION button
        if (digitalRead(BTN_ACTION) == LOW)
        {
            delay(300);
            startGame();
        }

        return;
    }

    // Read buttons
    readButtons();

    // Move snake according to game speed
    if (millis() - lastMove >= gameSpeed)
    {
        lastMove = millis();

        moveSnake();

        checkCollision();

        if (!gameOver)
        {
            checkFood();
        }
    }

    // Draw game
    drawGame();
}

// ==================================================
// START SCREEN
// ==================================================

void showStartScreen()
{
    oled.clearBuffer();

    oled.setFont(u8g2_font_ncenB14_tr);
    oled.drawStr(20, 25, "SNAKE");

    oled.setFont(u8g2_font_6x10_tr);
    oled.drawStr(25, 42, "Press ACTION");
    oled.drawStr(35, 54, "to start");

    oled.sendBuffer();

    // Wait until ACTION is pressed
    while (digitalRead(BTN_ACTION) == HIGH)
    {
        delay(10);
    }

    delay(300);

    startGame();
}

// ==================================================
// START GAME
// ==================================================

void startGame()
{
    gameOver = false;

    score = 0;

    snakeLength = 3;

    // Starting position
    snakeX[0] = 15;
    snakeY[0] = 8;

    snakeX[1] = 14;
    snakeY[1] = 8;

    snakeX[2] = 13;
    snakeY[2] = 8;

    // Start moving right
    directionX = 1;
    directionY = 0;

    gameSpeed = 150;

    spawnFood();

    lastMove = millis();
}

// ==================================================
// READ BUTTONS
// ==================================================

void readButtons()
{
    bool left = digitalRead(BTN_LEFT);
    bool right = digitalRead(BTN_RIGHT);
    bool action = digitalRead(BTN_ACTION);

    // ==================================================
    // LEFT BUTTON
    // ==================================================

    if (left == LOW && lastLeft == HIGH)
    {
        // Turn left depending on current direction

        if (directionX == 1)
        {
            directionX = 0;
            directionY = -1;
        }
        else if (directionX == -1)
        {
            directionX = 0;
            directionY = 1;
        }
        else if (directionY == 1)
        {
            directionX = 1;
            directionY = 0;
        }
        else if (directionY == -1)
        {
            directionX = -1;
            directionY = 0;
        }
    }

    // ==================================================
    // RIGHT BUTTON
    // ==================================================

    if (right == LOW && lastRight == HIGH)
    {
        // Turn right depending on current direction

        if (directionX == 1)
        {
            directionX = 0;
            directionY = 1;
        }
        else if (directionX == -1)
        {
            directionX = 0;
            directionY = -1;
        }
        else if (directionY == 1)
        {
            directionX = -1;
            directionY = 0;
        }
        else if (directionY == -1)
        {
            directionX = 1;
            directionY = 0;
        }
    }

    // Save button states
    lastLeft = left;
    lastRight = right;
    lastAction = action;
}

// ==================================================
// MOVE SNAKE
// ==================================================

void moveSnake()
{
    // Move body
    for (int i = snakeLength - 1; i > 0; i--)
    {
        snakeX[i] = snakeX[i - 1];
        snakeY[i] = snakeY[i - 1];
    }

    // Move head
    snakeX[0] += directionX;
    snakeY[0] += directionY;
}

// ==================================================
// COLLISION
// ==================================================

void checkCollision()
{
    // ==================================================
    // WALL COLLISION
    // ==================================================

    if (
        snakeX[0] < 0 ||
        snakeX[0] >= GRID_WIDTH ||
        snakeY[0] < 0 ||
        snakeY[0] >= GRID_HEIGHT
    )
    {
        gameOver = true;
        return;
    }

    // ==================================================
    // SELF COLLISION
    // ==================================================

    for (int i = 1; i < snakeLength; i++)
    {
        if (
            snakeX[0] == snakeX[i] &&
            snakeY[0] == snakeY[i]
        )
        {
            gameOver = true;
            return;
        }
    }
}

// ==================================================
// SPAWN FOOD
// ==================================================

void spawnFood()
{
    bool valid = false;

    while (!valid)
    {
        foodX = random(0, GRID_WIDTH);
        foodY = random(0, GRID_HEIGHT);

        valid = true;

        // Don't spawn food inside snake
        for (int i = 0; i < snakeLength; i++)
        {
            if (
                foodX == snakeX[i] &&
                foodY == snakeY[i]
            )
            {
                valid = false;
                break;
            }
        }
    }
}

// ==================================================
// CHECK FOOD
// ==================================================

void checkFood()
{
    if (
        snakeX[0] == foodX &&
        snakeY[0] == foodY
    )
    {
        // Increase snake length
        if (snakeLength < MAX_SNAKE)
        {
            snakeLength++;
        }

        // Increase score
        score++;

        // Spawn new food
        spawnFood();

        // Increase difficulty
        if (gameSpeed > 60)
        {
            gameSpeed -= 5;
        }
    }
}

// ==================================================
// DRAW GAME
// ==================================================

void drawGame()
{
    oled.clearBuffer();

    // ==================================================
    // SCORE
    // ==================================================

    oled.setFont(u8g2_font_6x10_tr);

    char scoreText[20];

    sprintf(scoreText, "Score: %d", score);

    oled.drawStr(2, 8, scoreText);

    // ==================================================
    // FOOD
    // ==================================================

    oled.drawBox(
        foodX * CELL_SIZE,
        foodY * CELL_SIZE,
        CELL_SIZE,
        CELL_SIZE
    );

    // ==================================================
    // SNAKE
    // ==================================================

    for (int i = 0; i < snakeLength; i++)
    {
        oled.drawBox(
            snakeX[i] * CELL_SIZE,
            snakeY[i] * CELL_SIZE,
            CELL_SIZE,
            CELL_SIZE
        );
    }

    oled.sendBuffer();
}

// ==================================================
// GAME OVER
// ==================================================

void showGameOver()
{
    oled.clearBuffer();

    oled.setFont(u8g2_font_ncenB10_tr);

    oled.drawStr(25, 20, "GAME OVER");

    oled.setFont(u8g2_font_6x10_tr);

    char scoreText[20];

    sprintf(scoreText, "Score: %d", score);

    oled.drawStr(42, 35, scoreText);

    oled.drawStr(22, 50, "ACTION = Restart");

    oled.sendBuffer();

    delay(100);
}
